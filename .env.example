# Choose one provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override provider default models.
PHRASIFY_ANTHROPIC_MODEL=claude-sonnet-4-20250514
PHRASIFY_OPENAI_MODEL=

# Optional: include Notion target metadata in handoff JSON.
# Phrasify does not write to Notion directly.
PHRASIFY_NOTION_DATABASE_ID=
PHRASIFY_NOTION_DATA_SOURCE_ID=
